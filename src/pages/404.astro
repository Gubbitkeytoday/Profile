---
/**
 * Bilingual 404. GitHub Pages serves `/Profile/404.html` automatically for any
 * missing path under the project site, so this single page covers both locales.
 */
import Footer from '@/components/layout/Footer.astro';
import Nav from '@/components/layout/Nav.astro';
import Icon from '@/components/ui/Icon.astro';
import { href } from '@/i18n';
import Base from '@/layouts/Base.astro';
---

<Base
  lang="th"
  title="ไม่พบหน้านี้ · Page not found — 404"
  description="ไม่พบหน้าที่คุณต้องการ — The page you were looking for could not be found."
  path="/"
  noindex
>
  <Nav lang="th" />
  <main id="main" tabindex="-1" class="nf">
    <div class="shell nf__inner">
      <p class="label nf__eyebrow">
        <span>ข้อผิดพลาด</span>
        <span aria-hidden="true">·</span>
        <span lang="en">Error</span>
      </p>
      <h1 class="nf__code">
        <span aria-hidden="true">404</span>
        <span class="sr-only">404 — ไม่พบหน้านี้ / Page not found</span>
      </h1>

      <div class="nf__copy">
        <div>
          <p class="nf__title">ไม่พบหน้านี้</p>
          <p class="nf__text">ลิงก์อาจพิมพ์ผิด หรือหน้านี้ถูกย้ายไปแล้ว ลองกลับไปที่หน้าแรกเพื่อดูผลงานทั้งหมด</p>
        </div>
        <div lang="en">
          <p class="nf__title">Page not found</p>
          <p class="nf__text">The link may be mistyped, or the page has moved. Head back home to browse all projects.</p>
        </div>
      </div>

      <div class="nf__actions">
        <a class="nf__btn nf__btn--primary" href={href('th', '/')}>
          <Icon name="lucide:arrow-left" />
          <span>กลับหน้าแรก</span>
        </a>
        <a class="nf__btn" href={href('en', '/')} lang="en" hreflang="en">
          <Icon name="lucide:house" />
          <span>Back to home (English)</span>
        </a>
      </div>
    </div>
  </main>
  <Footer lang="th" />
</Base>

<style>
  .nf {
    position: relative;
    display: grid;
    min-height: calc(100svh - var(--spacing-nav));
    align-items: center;
    padding-block: var(--spacing-section);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: center top;
  }
  .nf__inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .nf__eyebrow {
    display: flex;
    gap: 0.5rem;
    color: var(--accent);
  }
  .nf__code {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(7rem, 4rem + 18vw, 16rem);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: var(--tracking-tightest);
    color: var(--fg);
  }
  .nf__code > span[aria-hidden] {
    background: linear-gradient(180deg, var(--fg) 30%, color-mix(in oklch, var(--accent) 80%, var(--fg)));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nf__copy {
    display: grid;
    gap: 1.5rem;
    max-width: 60rem;
  }
  @media (min-width: 48rem) {
    .nf__copy {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
  .nf__title {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: var(--text-display-sm);
    font-weight: 600;
    color: var(--fg);
  }
  .nf__text {
    margin: 0;
    color: var(--fg-2);
    line-height: 1.7;
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .nf__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.65rem 1.1rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-md);
    color: var(--fg);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }
  .nf__btn:hover {
    background: var(--bg-2);
  }
  .nf__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .nf__btn--primary {
    border-color: transparent;
    background: var(--accent);
    color: var(--on-accent);
  }
  .nf__btn--primary:hover {
    background: color-mix(in oklch, var(--accent) 88%, var(--fg));
  }
</style>
