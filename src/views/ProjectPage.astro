---
import CommandPalette from '@/components/layout/CommandPalette.astro';
import Footer from '@/components/layout/Footer.astro';
import Nav from '@/components/layout/Nav.astro';
import ProjectDetail from '@/components/project/ProjectDetail.astro';
import type { Lang } from '@/i18n';
import Base from '@/layouts/Base.astro';
import type { Project } from '@/lib/projects';

interface Props {
  lang: Lang;
  project: Project;
  prev: Project | undefined;
  next: Project | undefined;
}

const { lang, project, prev, next } = Astro.props;
const { title, summary } = project.data;
---

<Base
  lang={lang}
  title={`${title[lang]} — ${lang === 'th' ? 'ผลงาน' : 'Project'} · Wongsathorn C.`}
  description={summary[lang]}
  path={`/projects/${project.id}/`}
  ogImage={project.id}
  type="article"
>
  <Nav lang={lang} />
  <main id="main" tabindex="-1">
    <ProjectDetail lang={lang} project={project} prev={prev} next={next} />
  </main>
  <Footer lang={lang} />
  <CommandPalette lang={lang} />
</Base>
