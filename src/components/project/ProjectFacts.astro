---
import Icon from '@/components/ui/Icon.astro';
import { href, type Lang, makeT } from '@/i18n';
import { projectIcon, tagIcon } from '@/lib/icons';
import type { Project } from '@/lib/projects';
import { CATEGORY, dict } from './dict';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const t = makeT(dict, lang);
const { tags, year, category, icon, live, repo } = project.data;
const host = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
// Tags are always Latin product names; mark them for screen readers in Thai mode.
const tagLang = lang === 'th' ? 'en' : undefined;
---

<aside class="facts" aria-labelledby="facts-title">
  <h3 id="facts-title" class="facts__title">{t('facts')}</h3>

  <dl class="facts__list">
    <div class="facts__row facts__row--stack">
      <dt>{t('stack')}</dt>
      <dd>
        <ul role="list" class="chips">
          {
            tags.map((tag) => (
              <li>
                <a class="chip" href={href(lang, `/?tech=${encodeURIComponent(tag)}#work`)}>
                  <Icon name={tagIcon(tag)} size={15} brand />
                  <span lang={tagLang}>{tag}</span>
                  <span class="sr-only">
                    — {t('stackFilter')} {tag}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </dd>
    </div>

    <div class="facts__row">
      <dt>{t('year')}</dt>
      <dd class="font-mono tabular-nums">{year}</dd>
    </div>

    <div class="facts__row">
      <dt>{t('category')}</dt>
      <dd class="inline-flex items-center gap-2">
        <Icon name={projectIcon(icon)} size={16} class="text-fg-3" />
        {CATEGORY[category][lang]}
      </dd>
    </div>

    {
      (live || repo) && (
        <div class="facts__row facts__row--links">
          <dt>{t('links')}</dt>
          <dd>
            <ul role="list" class="links">
              {live && (
                <li>
                  <a class="link" href={live} target="_blank" rel="noopener">
                    <Icon name="lucide:globe" size={16} />
                    <span class="link__text">
                      <span class="link__k">{t('live')}</span>
                      <span class="link__v" lang="en">
                        {host(live)}
                      </span>
                    </span>
                    <Icon name="lucide:arrow-up-right" size={16} class="link__arrow" />
                    <span class="sr-only">{t('newTab')}</span>
                  </a>
                </li>
              )}
              {repo && (
                <li>
                  <a class="link" href={repo} target="_blank" rel="noopener">
                    <Icon name="simple-icons:github" size={16} />
                    <span class="link__text">
                      <span class="link__k">{t('source')}</span>
                      <span class="link__v" lang="en">
                        {host(repo).replace(/^github\.com\//, '')}
                      </span>
                    </span>
                    <Icon name="lucide:arrow-up-right" size={16} class="link__arrow" />
                    <span class="sr-only">{t('newTab')}</span>
                  </a>
                </li>
              )}
            </ul>
          </dd>
        </div>
      )
    }
  </dl>
</aside>

<style>
  .facts {
    position: relative;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--bg-1);
    box-shadow: var(--elev-1);
  }
  .facts::before,
  .facts::after {
    content: '';
    position: absolute;
    width: 10px;
    height: 10px;
    border: 0 solid var(--accent);
    pointer-events: none;
  }
  .facts::before {
    top: -6px;
    left: -6px;
    border-width: 1px 0 0 1px;
  }
  .facts::after {
    right: -6px;
    bottom: -6px;
    border-width: 0 1px 1px 0;
  }
  .facts__title {
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  :lang(th) .facts__title {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    letter-spacing: 0;
    text-transform: none;
  }
  .facts__list {
    margin: 0;
  }
  .facts__row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.9rem;
    border-top: 1px solid var(--line);
  }
  .facts__row--stack,
  .facts__row--links {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }
  .facts__row--stack {
    border-top: 0;
    padding-top: 0;
  }
  .facts__row dt {
    font-size: 0.875rem;
    color: var(--fg-3);
  }
  .facts__row dd {
    margin: 0;
    color: var(--fg);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.25rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-2);
    color: var(--fg-2);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
    transition:
      border-color var(--duration-fast) var(--ease-out-expo),
      color var(--duration-fast) var(--ease-out-expo),
      background-color var(--duration-fast) var(--ease-out-expo);
  }
  /* Monochrome marks by default; the official brand colour appears on hover/focus. */
  .chip :global(.icon) {
    color: var(--fg-3);
    transition: color var(--duration-fast) var(--ease-out-expo);
  }
  .chip:is(:hover, :focus-visible) {
    border-color: var(--line-2);
    background: var(--bg-3);
    color: var(--fg);
  }
  .chip:is(:hover, :focus-visible) :global(.icon--brand) {
    color: var(--brand, var(--fg));
  }
  .chip:is(:hover, :focus-visible) :global(.icon:not(.icon--brand)),
  :global([data-theme='dark']) .chip:is(:hover, :focus-visible) :global(.icon--brand:is([style*='--brand:#000000'], [style*='--brand:#181717'], [style*='--brand:#0F0F11'], [style*='--brand:#2D3748'], [style*='--brand:#003B57'], [style*='--brand:#003545'], [style*='--brand:#333333'])) {
    color: var(--fg);
  }

  .links {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-2);
    color: var(--fg);
    transition:
      border-color var(--duration-fast) var(--ease-out-expo),
      background-color var(--duration-fast) var(--ease-out-expo);
  }
  .link:is(:hover, :focus-visible) {
    border-color: var(--line-2);
    background: var(--bg-3);
  }
  .link__text {
    display: grid;
    min-width: 0;
    flex: 1;
    line-height: 1.3;
  }
  .link__k {
    font-size: 0.875rem;
    font-weight: 500;
  }
  .link__v {
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-3);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .link :global(.link__arrow) {
    color: var(--fg-3);
    transition:
      translate var(--duration-fast) var(--ease-out-expo),
      color var(--duration-fast) var(--ease-out-expo);
  }
  .link:is(:hover, :focus-visible) :global(.link__arrow) {
    color: var(--accent);
    translate: 2px -2px;
  }
</style>
