---
import SectionHead from '@/components/profile/SectionHead.astro';
import SkillTile from '@/components/skills/SkillTile.astro';
import { DOMAINS } from '@/components/skills/tech';
import { type Lang, makeT } from '@/i18n';
import { getProjects } from '@/lib/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const projects = await getProjects();
const dict = {
  th: {
    eyebrow: 'ทักษะ',
    title: 'เครื่องมือที่ใช้สร้างงานจริง',
    lead: 'จัดกลุ่มตามงานที่ทำ ตัวเลขทุกตัวนับจากโปรเจกต์ด้านบน — กดที่เทคโนโลยีเพื่อดูว่าใช้ในงานไหนบ้าง',
  },
  en: {
    eyebrow: 'Skills',
    title: 'The stack I actually ship with.',
    lead: 'Grouped by the work it does. Every number is counted from the projects above — pick a tool to see where I used it.',
  },
};
const t = makeT(dict, lang);
---

<section id="skills" aria-labelledby="skills-title" class="py-section">
  <div class="shell">
    <SectionHead num="02" eyebrow={t('eyebrow')} title={t('title')} id="skills-title" lead={t('lead')} />
    <div class="mt-12 grid gap-4 lg:mt-16 lg:grid-cols-12 lg:gap-5">
      {DOMAINS.map((domain, i) => <SkillTile lang={lang} domain={domain} index={i} projects={projects} />)}
    </div>
  </div>
</section>
