---
import { countTechnologies, PRINCIPLES, START_YEAR, yearsBuilding } from '@/components/profile/facts';
import SectionHead from '@/components/profile/SectionHead.astro';
import { type Lang, makeT } from '@/i18n';
import { getProjects } from '@/lib/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const projects = await getProjects();
const count = projects.length;

const dict = {
  th: {
    eyebrow: 'เกี่ยวกับ',
    title: 'ผมไม่หยุดแค่ “ทำงานได้”',
    p1: 'ผมชื่อวงศธร ฉาบสีทอง ชื่อเล่นดรีม นักศึกษาปริญญาตรีชั้นปีที่ 3 สาขาเทคโนโลยีสารสนเทศ อยู่ที่หัวหิน — เป็น Full-Stack Developer ที่สร้างระบบตั้งแต่ฐานข้อมูล API จนถึงหน้าจอที่ใช้งานได้จริง',
    p2: `ตอนนี้มีผลงาน ${count} โปรเจกต์ ตั้งแต่แพลตฟอร์มข้อมูลขนส่งมวลชน (BKK Transit) ระบบ POS ระบบสแกนใบหน้าลงเวลา แชท AI แบบสตรีม เว็บจำลองรถไฟฟ้า 3 มิติ ไปจนถึงอีคอมเมิร์ซสองงาน`,
    stats: 'ตัวเลขจากผลงาน',
    sProjects: 'โปรเจกต์ในพอร์ตโฟลิโอ',
    sTech: 'เทคโนโลยีที่ใช้ในผลงาน',
    sYears: `ปีที่พัฒนาต่อเนื่อง · ตั้งแต่ ${START_YEAR}`,
    sLive: 'เว็บที่เปิดใช้งานจริง',
    how: 'วิธีทำงานของผม',
  },
  en: {
    eyebrow: 'About',
    title: 'I don’t stop at “it works.”',
    p1: 'I’m Wongsathorn Chapseethong — Dream. A third-year Information Technology undergraduate in Hua Hin, and a full-stack developer who builds systems end to end: database, API and an interface that holds up in real use.',
    p2: `${count} projects so far — an open transit data platform (BKK Transit), a POS, face-recognition attendance, streaming AI chat, a 3D city rail simulation and two e-commerce builds.`,
    stats: 'Numbers from the work',
    sProjects: 'Projects in this portfolio',
    sTech: 'Technologies across projects',
    sYears: `Years building · since ${START_YEAR}`,
    sLive: 'Live sites',
    how: 'How I work',
  },
};
const t = makeT(dict, lang);

const stats = [
  { value: count, suffix: '', label: t('sProjects') },
  { value: countTechnologies(projects), suffix: '', label: t('sTech') },
  { value: yearsBuilding(), suffix: '+', label: t('sYears') },
  { value: projects.filter((p) => p.data.live).length, suffix: '', label: t('sLive') },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="about" aria-labelledby="about-title" class="py-section">
  <div class="shell">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <SectionHead num="04" eyebrow={t('eyebrow')} title={t('title')} id="about-title" class="lg:col-span-5" />
      <div class="space-y-5 text-lg leading-relaxed text-fg-2 lg:col-span-7 lg:pt-12 [&>p]:max-w-[62ch]">
        <p class="text-fg">{t('p1')}</p>
        <p>{t('p2')}</p>
      </div>
    </div>

    <dl class="stats mt-16 grid grid-cols-2 border-y border-line lg:mt-20 lg:grid-cols-4" aria-label={t('stats')}>
      {
        stats.map((s, i) => (
          <div class:list={['stat flex flex-col-reverse justify-end gap-3 px-1 py-7 sm:px-6 sm:py-9', i > 0 && 'stat--sep']}>
            <dt class="text-sm leading-snug text-fg-3">{s.label}</dt>
            <dd class="font-display text-display-lg leading-none font-semibold tracking-tightest text-fg tabular-nums">
              <span data-count={s.value} aria-hidden="true">
                {s.value}
              </span>
              {s.suffix && (
                <span class="text-accent" aria-hidden="true">
                  {s.suffix}
                </span>
              )}
              <span class="sr-only">
                {s.value}
                {s.suffix}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-16 lg:mt-20">
      <h3 class="label">{t('how')}</h3>
      <ol class="mt-6 grid gap-x-10 gap-y-8 md:grid-cols-3">
        {
          PRINCIPLES.map((pr, i) => (
            <li class="border-t border-line pt-6">
              <span class="font-mono text-sm text-accent tabular-nums" aria-hidden="true">
                {pad(i + 1)}
              </span>
              <p class="mt-3 font-display text-xl font-semibold text-fg">{pr.title[lang]}</p>
              <p class="mt-2 text-[0.95rem] leading-relaxed text-fg-2">{pr.body[lang]}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* Hairline dividers: every cell after the first in a row (2-up on mobile, 4-up on desktop). */
  @media (max-width: 1023.98px) {
    .stat:nth-child(even) {
      border-left: 1px solid var(--line);
      padding-left: 1.25rem;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  @media (min-width: 1024px) {
    .stat--sep {
      border-left: 1px solid var(--line);
    }
  }
</style>

<script>
  import { prefersReducedMotion } from '@/scripts/ui';

  /* Count-up: numbers are already final in the HTML; we only animate if motion is welcome. */
  function init() {
    const els = document.querySelectorAll<HTMLElement>('#about [data-count]:not([data-counted])');
    if (!els.length || prefersReducedMotion() || !('IntersectionObserver' in window)) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          io.unobserve(el);
          const end = Number(el.dataset.count);
          const t0 = performance.now();
          const dur = 900;
          const step = (now: number) => {
            const k = Math.min(1, (now - t0) / dur);
            el.textContent = String(Math.round(end * (1 - (1 - k) ** 3)));
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
      },
      { threshold: 0.6 },
    );
    for (const el of els) {
      el.dataset.counted = '';
      const r = el.getBoundingClientRect();
      if (r.top < innerHeight && r.bottom > 0) continue; // already on screen: leave the final value
      el.textContent = '0';
      io.observe(el);
    }
  }
  init();
</script>
