---
/**
 * CSS-driven tech marquee. The first track is the accessible list; the duplicate
 * that makes the loop seamless is aria-hidden. Motion only starts once the
 * pause button is wired (WCAG 2.2.2); it also pauses on hover / focus-within,
 * and is a static wrapped list under prefers-reduced-motion.
 */
import { MARQUEE } from '@/components/skills/tech';
import Icon from '@/components/ui/Icon.astro';
import { type Lang, makeT } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = {
  th: { label: 'เทคโนโลยีหลักที่ใช้', pause: 'หยุดแถบเทคโนโลยีที่เลื่อนอยู่' },
  en: { label: 'Core stack', pause: 'Pause the scrolling tech list' },
};
const t = makeT(dict, lang);
---

<div class="marquee relative border-y border-line bg-bg" data-marquee>
  <div class="viewport overflow-hidden">
    <div class="track flex w-max">
      {
        [0, 1].map((copy) => (
          <ul
            class="list flex shrink-0 items-center"
            aria-label={copy === 0 ? t('label') : undefined}
            aria-hidden={copy === 1 ? 'true' : undefined}
          >
            {MARQUEE.map((item) => (
              <li class="item flex items-center gap-2.5 whitespace-nowrap font-mono text-sm text-fg-2" lang="en">
                <Icon name={item.icon} size={18} brand />
                {item.name}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
  <div class="ctrl">
    <button type="button" class="toggle" aria-pressed="false" aria-label={t('pause')} title={t('pause')} hidden>
      <Icon name="lucide:pause" size={14} class="i-pause" />
      <Icon name="lucide:play" size={14} class="i-play" />
    </button>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-marquee]:not([data-js])')) {
    const btn = root.querySelector<HTMLButtonElement>('.toggle');
    if (!btn) continue;
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const paused = btn.getAttribute('aria-pressed') !== 'true';
      btn.setAttribute('aria-pressed', String(paused));
      root.toggleAttribute('data-paused', paused);
    });
    root.dataset.js = '';
  }
</script>

<style>
  .marquee {
    --gap: clamp(2rem, 4vw, 3.5rem);
  }
  .viewport {
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 86%, transparent 94%);
    padding-block: 1.1rem;
  }
  .list {
    gap: var(--gap);
    padding-inline-end: var(--gap);
  }
  .item {
    transition: color var(--duration-fast) ease;
  }
  /* Monochrome by default; brand colour on hover (global dark-mode fixes still apply). */
  .item:not(:hover) :global(.icon--brand) {
    color: currentColor;
  }
  .item:hover {
    color: var(--fg);
  }

  .ctrl {
    position: absolute;
    inset-block: 0;
    inset-inline-end: max(0.5rem, calc(var(--spacing-gutter) - 0.75rem));
    display: grid;
    place-items: center;
  }
  .toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--bg-1);
    color: var(--fg-2);
    cursor: pointer;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }
  .toggle[hidden] {
    display: none;
  }
  /* 44px hit area around the 36px visual. */
  .toggle::before {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 2.75rem;
    height: 2.75rem;
    translate: -50% -50%;
  }
  .toggle:hover {
    color: var(--fg);
    border-color: var(--fg-3);
  }
  .toggle :global(.i-play),
  .toggle[aria-pressed='true'] :global(.i-pause) {
    display: none;
  }
  .toggle[aria-pressed='true'] :global(.i-play) {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee[data-js] .track {
      animation: marquee 48s linear infinite;
    }
    .marquee:hover .track,
    .marquee:focus-within .track,
    .marquee[data-paused] .track {
      animation-play-state: paused;
    }
  }
  @keyframes marquee {
    to {
      translate: -50% 0;
    }
  }

  /* Reduced motion: a calm, wrapped list; the duplicate and the control go away. */
  @media (prefers-reduced-motion: reduce) {
    .viewport {
      mask-image: none;
    }
    .track {
      width: auto;
      animation: none;
    }
    .list {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 0.75rem;
      column-gap: 1.75rem;
      padding-inline: var(--spacing-gutter);
      flex-shrink: 1;
    }
    .list[aria-hidden] {
      display: none;
    }
    .ctrl {
      display: none;
    }
  }
</style>
