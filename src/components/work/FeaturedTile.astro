---
/**
 * Featured bento tile. The whole tile is ONE link: the title <a> carries a
 * stretched ::after that covers the card (no role=button, no nested links).
 */
import Icon from '@/components/ui/Icon.astro';
import { href, type Lang, makeT } from '@/i18n';
import { projectIcon } from '@/lib/icons';
import { imageSrc, pickWidth, srcset } from '@/lib/media';
import { type Project, projectPath } from '@/lib/projects';
import { cardMetrics, categoryLabel, iconTags } from './meta';
import { splitTitle } from './shared';

export type TileSize = 'xl' | 'sm' | 'md';

interface Props {
  project: Project;
  lang: Lang;
  size: TileSize;
  /** Use a gallery image instead of the cover (path must exist in the gallery). */
  media?: string;
  /** `peek`: small/portrait captures float on a blueprint grid instead of being cropped. */
  fit?: 'cover' | 'peek';
}

const { project: p, lang, size, media, fit = 'cover' } = Astro.props;
const d = p.data;

const dict = {
  th: { metrics: 'ตัวเลขสำคัญ', stack: 'เทคโนโลยีหลัก', live: 'ออนไลน์', shot: 'ภาพหน้าจอ' },
  en: { metrics: 'Key numbers', stack: 'Core stack', live: 'Live', shot: 'Screenshot of' },
};
const t = makeT(dict, lang);

const fromGallery = media
  ? d.gallery.find((g): g is Extract<typeof g, { type: 'image' }> => g.type === 'image' && g.path === media)
  : undefined;
const img = fromGallery ?? { ...d.cover, format: 'webp' as const };
const ext = img.format === 'jpg' ? 'jpg' : 'webp';

const [name] = splitTitle(d.title[lang]);
const xl = size === 'xl';
const metrics = cardMetrics(p, xl ? 3 : 2);
const tags = iconTags(p, xl ? 6 : 4);

const sizes =
  fit === 'peek'
    ? '(min-width: 1024px) 13rem, 40vw'
    : xl
      ? '(min-width: 1024px) min(54rem, 64vw), (min-width: 768px) 46vw, (min-width: 640px) 60vw, 84vw'
      : '(min-width: 1024px) min(27rem, 31vw), (min-width: 768px) 46vw, (min-width: 640px) 60vw, 84vw';
const titleId = `tile-${p.id}`;
---

<li class:list={['tile', `tile--${size}`]}>
  <article class="card" aria-labelledby={titleId}>
    <div class:list={['media', fit === 'peek' && 'media--peek']}>
      <img
        src={imageSrc(img.path, pickWidth(img.widths, 960), ext)}
        srcset={srcset(img.path, img.widths, ext)}
        sizes={sizes}
        width={img.width}
        height={img.height}
        alt={`${t('shot')} ${name}`}
        loading="lazy"
        decoding="async"
        style={`view-transition-name: project-${p.id}`}
      />
      {
        d.live && (
          <span class="live">
            <span class="live-dot" aria-hidden="true" />
            {t('live')}
          </span>
        )
      }
    </div>

    <div class="body">
      <div class="meta">
        <span class="ico"><Icon name={projectIcon(d.icon)} /></span>
        <span class="cat">{categoryLabel(d.category, lang)}</span>
        <span class="sep" aria-hidden="true"></span>
        <span class="year">{d.year}</span>
        {
          tags.length > 0 && (
            <ul class="tags" role="list" aria-label={t('stack')}>
              {tags.map((x) => (
                <li>
                  <Icon name={x.icon} brand />
                  <span class="sr-only">{x.tag}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <h3 class="title" id={titleId}>
        <a class="link" href={href(lang, projectPath(p))}>
          {name}<Icon name="lucide:arrow-up-right" class="arrow" />
        </a>
      </h3>
      <p class="summary">{d.summary[lang]}</p>

      {
        metrics.length > 0 && (
          <ul class="metrics" role="list" aria-label={t('metrics')}>
            {metrics.map((m) => (
              <li class="chip">
                <strong>{m.value}</strong>
                <span>{m.label[lang]}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </article>
</li>

<style>
  .tile {
    position: relative;
    display: flex;
    min-width: 0;
  }

  /* Blueprint corner ticks — light up on hover / focus. */
  .tile::before,
  .tile::after {
    content: "";
    position: absolute;
    z-index: 2;
    width: 10px;
    height: 10px;
    border: 0 solid var(--line-2);
    pointer-events: none;
    transition:
      border-color var(--duration-base) var(--ease-out-expo),
      translate var(--duration-base) var(--ease-out-expo);
  }
  .tile::before {
    top: -5px;
    left: -5px;
    border-width: 1px 0 0 1px;
  }
  .tile::after {
    right: -5px;
    bottom: -5px;
    border-width: 0 1px 1px 0;
  }
  .tile:hover::before,
  .tile:focus-within::before {
    border-color: var(--accent);
    translate: -2px -2px;
  }
  .tile:hover::after,
  .tile:focus-within::after {
    border-color: var(--accent);
    translate: 2px 2px;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--bg-1);
    box-shadow: var(--elev-1);
    transition: border-color var(--duration-base) var(--ease-out-expo);
  }
  .tile:hover .card {
    border-color: color-mix(in oklch, var(--accent) 45%, var(--line-2));
  }
  .card:has(.link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @supports selector(:has(a)) {
    .link:focus-visible {
      outline: none;
    }
  }

  /* --------------------------------------------------------------- media */
  .media {
    position: relative;
    flex: none;
    aspect-ratio: 16 / 10;
    margin: 0.5rem 0.5rem 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius-xl) - 0.5rem) calc(var(--radius-xl) - 0.5rem) var(--radius-md) var(--radius-md);
    background: var(--bg-2);
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: scale var(--duration-slow) var(--ease-out-expo);
  }
  .tile:hover .media img {
    scale: 1.035;
  }

  /* Portrait / small captures float on the blueprint grid instead of being upscaled. */
  .media--peek {
    background-color: var(--bg-2);
    background-image:
      radial-gradient(circle at 50% 120%, color-mix(in oklch, var(--violet) 18%, transparent), transparent 65%),
      linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size:
      100% 100%,
      20px 20px,
      20px 20px;
  }
  .media--peek img {
    position: absolute;
    top: 12%;
    left: 50%;
    width: min(13rem, 52%);
    height: auto;
    translate: -50% 0;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-md);
    box-shadow: var(--elev-2);
    transition: translate var(--duration-slow) var(--ease-out-expo);
  }
  .tile:hover .media--peek img {
    scale: 1;
    translate: -50% -6px;
  }

  .live {
    position: absolute;
    top: 0.625rem;
    left: 0.625rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.6rem 0.2rem 0.5rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: color-mix(in oklch, var(--bg-1) 90%, transparent);
    backdrop-filter: blur(8px);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: var(--text-3xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.5;
    text-transform: uppercase;
  }
  :global(:lang(th)) .live {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0;
    text-transform: none;
  }
  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--ok) 22%, transparent);
  }

  /* ---------------------------------------------------------------- body */
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.25rem 1.25rem;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 1.5rem;
    color: var(--fg-3);
    font-size: 0.8rem;
  }
  .ico {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-2);
    color: var(--fg-2);
    font-size: 0.8rem;
  }
  .cat {
    color: var(--fg-2);
    font-weight: 500;
  }
  .sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--line-2);
  }
  .year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .tags {
    display: flex;
    gap: 0.6rem;
    margin-inline-start: auto;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
  }
  .tags :global(.icon--brand) {
    color: var(--fg-3);
    transition: color var(--duration-base) var(--ease-out-expo);
  }
  /* Brand colour on hover; revert-layer keeps global.css's dark-mode fix for near-black marks. */
  .tile:hover .tags :global(.icon--brand) {
    color: revert-layer;
  }

  .title {
    margin-top: 0.15rem;
    color: var(--fg);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  :global(:lang(th)) .title {
    letter-spacing: 0;
    line-height: 1.35;
  }
  .link {
    color: inherit;
    text-decoration: none;
  }
  .link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .arrow {
    display: inline-block;
    margin-inline-start: 0.3em;
    color: var(--fg-3);
    font-size: 0.8em;
    vertical-align: 0;
    transition:
      translate var(--duration-base) var(--ease-out-expo),
      color var(--duration-base) var(--ease-out-expo);
  }
  .tile:hover .arrow,
  .link:focus-visible .arrow {
    color: var(--accent);
    translate: 2px -2px;
  }

  .summary {
    display: -webkit-box;
    overflow: hidden;
    color: var(--fg-2);
    font-size: 0.9rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    line-clamp: 1;
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
    padding: 0.35rem 0 0;
    list-style: none;
  }
  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.22rem 0.55rem;
    border: 1px solid color-mix(in oklch, var(--accent-2) 24%, transparent);
    border-radius: var(--radius-sm);
    background: color-mix(in oklch, var(--accent-2) 8%, transparent);
    color: var(--fg-2);
    font-size: 0.75rem;
    line-height: 1.35;
    white-space: nowrap;
  }
  .chip strong {
    color: var(--accent-2);
    font-family: var(--font-mono);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* ----------------------------------------------------- flagship (8 × 2) */
  .tile--xl .body {
    gap: 0.6rem;
    padding: 1.25rem 1.75rem 1.6rem;
  }
  .tile--xl .title {
    font-size: var(--text-display-sm);
    letter-spacing: -0.03em;
  }
  .tile--xl .summary {
    max-width: 62ch;
    font-size: 1rem;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  .tile--xl .chip {
    padding: 0.3rem 0.65rem;
    font-size: 0.8rem;
  }
  .tile--xl .media {
    margin: 0.625rem 0.625rem 0;
  }

  /* ------------------------------------------------------- bento (≥1024) */
  @media (min-width: 1024px) {
    .media {
      flex: 1 1 0;
      min-height: 7rem;
      aspect-ratio: auto;
    }
    .body {
      flex: none;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 1024px) {
      .tile {
        animation: tile-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
    }
  }
  @keyframes tile-in {
    from {
      opacity: 0;
      translate: 0 1.5rem;
    }
  }
</style>
